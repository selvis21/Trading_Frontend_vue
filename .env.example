# ------------------------------------------------------------------
# Standalone CRM frontend — environment.
# Copy to `.env` (or .env.local) and adjust per environment.
# Only VITE_*-prefixed vars are exposed to the client bundle.
# ------------------------------------------------------------------

# Absolute base URL of the backend API, including the version prefix.
# This is the ONLY required variable. Examples:
#   http://localhost/api/v1
#   http://crm-api.local/api/v1
#   https://api.crm.example.com/api/v1
VITE_API_URL=http://localhost/api/v1

# Browser tab / app name.
VITE_APP_NAME="BPPrime CRM"

# Set to "true" ONLY if you switch from bearer tokens to Sanctum's
# stateful cookie flow (requires a shared parent domain + CORS credentials).
VITE_API_WITH_CREDENTIALS=false
